    {
      "name": "02 - Get Booking IDs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is an array\", function () {\r",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Booking IDs are available\", function () {\r",
              "    const data = pm.response.json();\r",
              "\r",
              "    if (data.length > 0) {\r",
              "        pm.expect(data[0]).to.have.property(\"bookingid\");\r",
              "    }\r",
              "});\r",
              "\r",
              "const data = pm.response.json();\r",
              "\r",
              "if (data.length > 0) {\r",
              "    pm.environment.set(\"bookingId\", data[0].bookingid);\r",
              "}\r",
              "\r",
              "pm.test(\"Response time is below 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
